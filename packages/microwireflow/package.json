{
  "name": "@microx-technologies/microwireflow",
  "version": "0.1.1",
  "description": "Code-first wireflow docs library: plain TSX screens, declarative flow wiring, live React Flow canvas.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/microx-technologies/microwireflow.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@tisoap/react-flow-smart-edge": "^5.0.0",
    "elkjs": "^0.11.0",
    "html-to-image": "^1.11.13"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "@xyflow/react": "^12"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@xyflow/react": "^12.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.3.0",
    "typescript": "^5",
    "vite": "^8.0.0",
    "vitest": "^5.0.5"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./flow": {
      "types": "./dist/flow.d.ts",
      "import": "./dist/flow.js",
      "require": "./dist/flow.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "license": "AGPL-3.0"
}
