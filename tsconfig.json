{
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "esnext",
    "moduleDetection": "force",
    "noEmit": true,
    "types": ["bun"],

    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"],
      "@demo/*": ["./apps/demo/src/*"],
      "microwireflow": ["./src/index.ts"],
      "microwireflow/*": ["./src/*"],
    },
    "verbatimModuleSyntax": true,

    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  },
  "include": ["src", "tests", "tsup.config.ts", "vitest.config.ts", "tests/defineFlow.test.ts", "tests/edges.test.ts", "tests/syncNodes.test.ts"]
}
